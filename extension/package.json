{
  "name": "session-board-vscode",
  "displayName": "Session Board for VS Code",
  "description": "Your Claude Code sessions at a glance across every VS Code window: who needs input, who is working, context and usage limits, click to jump, ✕ to end, search every session.",
  "version": "0.4.3",
  "publisher": "nima-ghorbani",
  "license": "MIT",
  "preview": true,
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nghorbani/session-board.git"
  },
  "bugs": {
    "url": "https://github.com/nghorbani/session-board/issues"
  },
  "homepage": "https://github.com/nghorbani/session-board#readme",
  "keywords": [
    "claude code",
    "sessions",
    "agents",
    "dashboard",
    "search"
  ],
  "galleryBanner": {
    "color": "#14161a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Lists Claude Code sessions from the user profile; it reads no workspace files."
    },
    "virtualWorkspaces": true
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test \"tests/*.test.cjs\""
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionBoard",
          "title": "Session Board",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sessionBoard": [
        {
          "type": "webview",
          "id": "sessionBoard.view",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "sessionBoard.refresh",
        "title": "Refresh",
        "category": "Session Board",
        "icon": "$(refresh)"
      },
      {
        "command": "sessionBoard.open",
        "title": "Open Session…",
        "category": "Session Board"
      },
      {
        "command": "sessionBoard.search",
        "title": "Search Sessions…",
        "category": "Session Board",
        "icon": "$(search)"
      },
      {
        "command": "sessionBoard.refreshUsage",
        "title": "Refresh Usage Limits",
        "category": "Session Board"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sessionBoard.search",
          "when": "view == sessionBoard.view",
          "group": "navigation@1"
        },
        {
          "command": "sessionBoard.refresh",
          "when": "view == sessionBoard.view",
          "group": "navigation@2"
        }
      ]
    }
  }
}
